{
  "namespace": "qol_hud",

  "elytra_swap_icon": {
    "type": "image",
    "texture": "textures/ui/elytra_swap",
    "size": [ 22, 22 ]
  },

  "elytra_swap_button@common.button": {
    "size": [ 28, 28 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -55, 4 ],
    "$pressed_button_name": "button.elytra_swap_click",
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      }
    ],
    "controls": [
      {
        "icon@qol_hud.elytra_swap_icon": {}
      }
    ]
  },

  "hud_screen": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "elytra_swap_panel": {
            "type": "panel",
            "controls": [
              {
                "elytra_swap_button@qol_hud.elytra_swap_button": {}
              }
            ]
          }
        }
      }
    ]
  }
}
